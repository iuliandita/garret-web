{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garret-web",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "usegarret.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
