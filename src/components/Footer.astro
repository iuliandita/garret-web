---
import BrandText from './BrandText.astro';
import { copy, pageUrl, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<footer class="site-footer wrap">
  <p>{t.footer.license}</p>
  <nav aria-label={locale === 'de' ? 'Weitere Informationen' : 'Further information'}>
    <a href={pageUrl(locale, 'about')}><BrandText text={t.footer.about} /></a>
    <a href={pageUrl(locale, 'about') + '#credits'}>{t.footer.credits}</a>
    <a href="https://github.com/iuliandita/garret/issues">{t.footer.issues}</a>
    <a href="https://ko-fi.com/Q3O027XM2F"><BrandText text={t.footer.support} /></a>
  </nav>
  <p class="creator-link"><a href="https://iuliandita.com">{t.footer.creator}</a></p>
</footer>
