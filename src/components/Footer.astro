---
import { copy, pageUrl, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<footer class="site-footer wrap">
  <p>{t.footer.license}</p>
  <nav aria-label={locale === 'de' ? 'Weitere Informationen' : 'Further information'}>
    <a href={pageUrl(locale, 'about')}>{t.footer.about}</a>
    <a href={pageUrl(locale, 'about') + '#credits'}>{t.footer.credits}</a>
    <a href="https://github.com/iuliandita/garret/issues">{t.footer.issues}</a>
    <a href="https://ko-fi.com/Q3O027XM2F">{t.footer.support}</a>
  </nav>
</footer>
