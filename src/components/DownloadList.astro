---
import BrandText from './BrandText.astro';
import { release, type Platform, type PlatformRelease } from '../data/releases';
import { pages } from '../content/pages';
import { pageUrl, type Locale } from '../content';
import OsIcon from './OsIcon.astro';
interface Props { locale: Locale; platforms?: Record<Platform, PlatformRelease> }
const { locale, platforms = release.platforms } = Astro.props;
const t = pages[locale].downloads;
---
<div class="downloads">
  {(Object.keys(platforms) as Platform[]).map(platform => {
    const data: PlatformRelease = platforms[platform];
    return <section class="download-platform" id={platform} data-platform={platform}>
      <div class="download-heading"><h2><OsIcon platform={platform} />{data.label}</h2><span class="suggestion" data-suggestion hidden>{t.suggested}</span></div>
      <p>{t.requirements[platform]}</p>
      {platform === 'linux' && <p class="linux-install">{t.linuxInstall}</p>}
      {platform === 'android' && <p class="android-note">{t.androidLimits} <a href={pageUrl(locale, 'guide') + '#android'}>{t.androidGuide}</a></p>}
      <div class="download-actions">
        {data.options.filter(option => !option.secondary).map(option =>
          option.url
            ? <a class="button" href={option.url}><BrandText text={t.downloadOption.replace('{option}', t.options[option.id])} /></a>
            : <div><p>{t.options[option.id]}: {t.missing}</p><a href={release.listingUrl}>{t.listing}</a></div>
        )}
      </div>
      {data.options.some(option => option.secondary) && <p class="portable-links">{t.portable} {data.options.filter(option => option.secondary).map((option, index) =>
        <>{index > 0 && ' · '}{option.url ? <a href={option.url}>{t.options[option.id]}</a> : <a href={release.listingUrl}>{t.options[option.id]}: {t.missing}</a>}</>
      )}</p>}
    </section>;
  })}
</div>
