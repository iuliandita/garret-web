---
import BrandText from './BrandText.astro';
import CodeText from './CodeText.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadList from './DownloadList.astro';
import { pages } from '../content/pages';
import { copy, pageUrl, type Locale } from '../content';
import { release, type Platform } from '../data/releases';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = pages[locale].downloads;
const published = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(release.published));
---
<SiteLayout locale={locale} title={copy[locale].nav.downloads} description={t.description} path="downloads">
  <div class="wrap">
    <div class="page-heading">
      <h1>{t.title}</h1><p><BrandText text={t.description} /></p>
      <p class="alpha-note">{t.alpha} <a href={pageUrl(locale, 'guide') + '#backup'}>{t.backup}</a>.</p>
      <p class="release-line">{t.version}: <a href={release.releaseUrl}>{release.tag}</a>, {t.published} <time datetime={release.published}>{published}</time>.</p>
      <p class="platform-availability">{t.available}</p>
      <nav class="platform-jump" aria-label={t.jump}>
        {(Object.keys(release.platforms) as Platform[]).map(platform => <a href={'#' + platform}>{release.platforms[platform].label}</a>)}
      </nav>
    </div>
    <DownloadList locale={locale} />
    <section class="download-notes">
      <h2>{t.changes}</h2>
      <ul>{t.changesList.map(item => <li>{item}</li>)}</ul>
      <p><a href={release.listingUrl}>{t.olderNotes}</a></p>
      <h2 id="installation-notes">{t.notes}</h2>
      <p>{t.instructions}</p>
      <p><CodeText text={t.signature.replace('{fingerprint}', '`' + release.signingFingerprint + '`')} /> <a href={release.verifyUrl}>{t.signatureSteps}</a></p>
      <p><a href={release.releaseUrl}>{t.checksums}</a></p>
      <p><a href="https://github.com/iuliandita/garret#building-from-source-linux">{t.source}</a></p>
    </section>
  </div>
</SiteLayout>
