---
import BrandText from './BrandText.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../content/pages';
import { copy, pageUrl, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = pages[locale].guide;
---
<SiteLayout locale={locale} title={copy[locale].nav.guide} description={t.description} path="guide">
  <div class="wrap">
    <div class="page-heading"><h1>{t.title}</h1><p><BrandText text={t.description} /></p></div>
    <div class="prose">
      <section><h2>{t.install}</h2><p>{t.installText}</p><p><a href={pageUrl(locale, 'downloads')}>{copy[locale].nav.downloads}</a></p></section>
      <section><h2>{t.book}</h2><p><BrandText text={t.bookText} /></p></section>
      <section><h2>{t.scene}</h2><p>{t.sceneText}</p></section>
      <section id="backup"><h2>{t.backup}</h2><p>{t.backupText}</p><ol>{t.steps.map(step => <li>{step}</li>)}</ol><p>{t.boundaries}</p><p>{t.restore}</p><p>{t.files}</p></section>
      <section><h2>{t.next}</h2><p>{t.nextText}</p></section>
    </div>
  </div>
</SiteLayout>
