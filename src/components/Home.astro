---
import SiteLayout from '../layouts/SiteLayout.astro';
import Screenshot from './Screenshot.astro';
import OsIcon from './OsIcon.astro';
import FeatureList from './FeatureList.astro';
import { pages } from '../content/pages';
import type { Platform } from '../data/releases';
import { copy, pageUrl, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<SiteLayout locale={locale} title={t.hero.title} description={t.hero.description}>
  <section class="hero wrap" aria-labelledby="headline">
    <div>
      <h1 id="headline">{t.hero.title}</h1>
      <p class="intro">{t.hero.description}</p>
      <div class="actions">
        <a class="button" href={pageUrl(locale, 'downloads')} data-os-download>
          <span data-default-label>{t.hero.download}</span>
          {(['linux', 'windows', 'macos', 'android'] as Platform[]).map(platform =>
            <span class="os-download-label" data-os-label={platform} hidden>
              <OsIcon platform={platform} />{pages[locale].downloads.download} {platform === 'macos' ? 'macOS' : platform === 'linux' ? 'Linux' : platform === 'windows' ? 'Windows' : 'Android'}
            </span>
          )}
        </a>
        <a href="#studio">{t.hero.explore}</a>
      </div>
    </div>
    <Screenshot locale={locale} src="/images/editor-light.png" darkSrc="/images/dark.png" alt={t.hero.alt} darkAlt={t.hero.darkAlt} caption={t.hero.caption} eager />
  </section>
  <nav class="feature-nav wrap" id="studio" aria-label={t.features.navigate}>
    <a href="#writing">{t.features.writing}</a>
    <a href="#organizing">{t.features.organizing}</a>
    <a href="#revision">{t.features.revision}</a>
    <a href="#publishing">{t.features.publishing}</a>
    <a href="#ownership">{t.features.recovery}</a>
  </nav>
  <section class="chapter wrap" id="writing">
    <div class="section-intro">
      <h2>{t.studio.title}</h2>
      <p>{t.studio.description}</p>
    </div>
    <div class="writing-note">
      <h3>{t.studio.write.title}</h3>
      <p>{t.studio.write.description}</p>
    </div>
    <FeatureList items={[t.features.focus, t.features.formatting, t.features.search, t.features.preferences]} />
  </section>
  <section class="chapter wrap" id="organizing">
    <div class="story-layout">
      <div><h2>{t.studio.organize.title}</h2><p>{t.studio.organize.description}</p></div>
      <Screenshot locale={locale} src="/images/timeline.png" alt={t.studio.organize.alt} caption={t.studio.organize.caption} />
    </div>
    <FeatureList items={[t.features.cast, t.features.bible, t.features.synopses, t.features.research, t.features.outline, t.features.appearances]} />
    <div class="feature-gallery">
      <Screenshot locale={locale} src="/images/cards.png" alt={t.features.cardsAlt} caption={t.features.cardsCaption} />
      <Screenshot locale={locale} src="/images/appearances.png" alt={t.features.appearancesAlt} caption={t.features.appearancesCaption} />
    </div>
  </section>
  <section class="chapter wrap revision" id="revision">
    <div class="section-intro"><h2>{t.studio.revise.title}</h2><p>{t.studio.revise.description}</p></div>
    <FeatureList items={[t.features.review, t.features.comments, t.features.history, t.features.revisions]} />
    <div class="feature-gallery">
      <Screenshot locale={locale} src="/images/review.png" alt={t.studio.revise.alt} caption={t.studio.revise.caption} />
      <Screenshot locale={locale} src="/images/history.png" alt={t.features.historyAlt} caption={t.features.historyCaption} />
    </div>
  </section>
  <section class="chapter wrap" id="publishing">
    <div class="publishing">
      <Screenshot locale={locale} src="/images/epub.png" alt={t.studio.prepare.alt} caption={t.studio.prepare.caption} />
      <div><h2>{t.studio.prepare.title}</h2><p>{t.studio.prepare.description}</p></div>
    </div>
    <FeatureList items={[t.features.export, t.features.design, t.features.authors, t.features.proof]} />
  </section>
  <section class="chapter wrap" id="ownership">
    <div class="ownership">
      <h2>{t.ownership.title}</h2>
      <div><p>{t.ownership.description}</p><p>{t.ownership.backup}</p><a href={pageUrl(locale, 'guide') + '#backup'}>{t.ownership.link}</a></div>
    </div>
    <FeatureList items={[t.features.archives, t.features.mirror, t.features.salvage, t.features.series, t.features.reports, t.features.lock]} />
  </section>
  <section class="chapter wrap phone">
    <div><h2>{t.android.title}</h2><p>{t.android.description}</p><a href={pageUrl(locale, 'downloads') + '#android'}>{t.hero.download}</a></div>
    <Screenshot locale={locale} src="/images/android-editor-light.png" darkSrc="/images/android-editor-dark.png" alt={t.android.alt} width={1080} height={2400} caption={t.android.caption} />
  </section>
</SiteLayout>
