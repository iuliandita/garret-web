---
import BrandText from './BrandText.astro';
import { Image } from 'astro:assets';
import notebook from '../assets/notebook.png';
import ownership from '../assets/ownership.png';
import SiteLayout from '../layouts/SiteLayout.astro';
import Screenshot from './Screenshot.astro';
import OsIcon from './OsIcon.astro';
import FeatureCarousel from './FeatureCarousel.astro';
import { release, type Platform } from '../data/releases';
import { copy, pageUrl, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<SiteLayout locale={locale} title={t.hero.title} description={t.hero.description}>
  <section class="hero wrap" aria-labelledby="headline">
    <div>
      <h1 id="headline">{t.hero.title}</h1>
      <p class="intro">{t.hero.description}</p>
      <div class="actions">
        <a class="button" href={pageUrl(locale, 'downloads')} data-os-download>
          <span data-default-label><BrandText text={t.hero.download} /></span>
          {(['linux', 'windows', 'macos', 'android'] as Platform[]).map(platform =>
            <span class="os-download-label" data-os-label={platform} hidden>
              <OsIcon platform={platform} /><span><BrandText text={t.hero.getFor.replace('{platform}', release.platforms[platform].label)} /></span>
            </span>
          )}
        </a>
        <a href="#studio">{t.hero.explore}</a>
      </div>
      <p class="hero-platform-note" data-android-note hidden>{t.hero.androidNote}</p>
      <p class="hero-alpha">{t.hero.alpha} <a href={pageUrl(locale, 'guide')}>{t.hero.alphaGuide}</a></p>
    </div>
    <Screenshot locale={locale} src="/images/editor-light.png" darkSrc="/images/dark.png" alt={t.hero.alt} darkAlt={t.hero.darkAlt} caption={t.hero.caption} eager />
  </section>
  <section class="chapter wrap highlights" id="studio">
    <div>
      <h2>{t.highlights.title}</h2>
      <div class="highlight-list">
        {[t.highlights.write, t.highlights.story, t.highlights.finish].map(item =>
          <article><h3>{item.title}</h3><p>{item.description}</p></article>
        )}
      </div>
    </div>
    <Image class="notebook-art" src={notebook} alt="" width={768} format="webp" quality={80} loading="lazy" />
  </section>
  <FeatureCarousel locale={locale} />
  <section class="chapter wrap ownership">
    <Image class="ownership-art" src={ownership} alt="" width={512} format="webp" quality={80} loading="lazy" />
    <div><h2>{t.ownership.title}</h2><p>{t.ownership.description}</p><p>{t.ownership.backup}</p><a href={pageUrl(locale, 'guide') + '#backup'}>{t.ownership.link}</a></div>
  </section>
  <section class="chapter wrap phone">
    <div><h2>{t.android.title}</h2><p><BrandText text={t.android.description} /></p><a href={pageUrl(locale, 'downloads') + '#android'}><BrandText text={t.android.download} /></a></div>
    <Screenshot locale={locale} src="/images/android-editor-light.png" darkSrc="/images/android-editor-dark.png" alt={t.android.alt} darkAlt={t.android.darkAlt} width={1080} height={2400} sizes="280px" caption={t.android.caption} />
  </section>
  <figure class="testimonial wrap" id="testimonial" aria-label={t.testimonial.label}>
    <blockquote lang="en"><p><q>It’s definitely a great tool for beginning writers, but a welcome tool for experienced writers wanting to keep everything organized and to industry writing standards.</q></p></blockquote>
    <figcaption>George Patterson</figcaption>
  </figure>
  <div class="closing-download wrap"><a class="button" href={pageUrl(locale, 'downloads')}>{t.allDownloads}</a></div>
</SiteLayout>
